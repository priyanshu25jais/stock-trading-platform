# Copy to .env for local development. On Render, set these under Environment.

# MongoDB connection string (MongoDB Atlas). Leave unset to run with
# in-memory sample data that resets whenever the server restarts.
MONGO_URL=mongodb+srv://USER:PASS@cluster.example.mongodb.net/DATABASE?retryWrites=true&w=majority

# Optional: comma-separated list of sites allowed to call the API.
# Leave unset to allow any origin.
# CORS_ORIGIN=https://stock-tradingdashboard.netlify.app,http://localhost:3000
