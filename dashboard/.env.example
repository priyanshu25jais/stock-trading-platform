# Public URL of the Vittora API (Render web service), no trailing slash.
# Set the same variable in Netlify: Site configuration > Environment variables.
REACT_APP_API_URL=https://stock-trading-platform-wezz.onrender.com

# Public URL of the Vittora website (used for "Back to website" links).
REACT_APP_SITE_URL=https://stock-tradingplatform.netlify.app

# For local development against a backend running on your machine:
# REACT_APP_API_URL=http://localhost:3002
